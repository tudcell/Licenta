# ============================================================================
# React Frontend Environment Variables
# ============================================================================
# Copy this file to .env.local and update the values as needed
# Note: In Vite, environment variables must be prefixed with VITE_

# Backend API URL
# Where the React app will send requests to
# Default: http://127.0.0.1:5000 (Flask backend on localhost)
# Production: https://your-api-domain.com
VITE_API_BASE_URL=http://127.0.0.1:5000

# WebSocket Server URL
# If not set, defaults to VITE_API_BASE_URL
# Used for real-time alerts stream
# Must support Socket.IO on /alerts namespace
# VITE_SOCKET_URL=http://127.0.0.1:5000

