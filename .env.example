# ============================================================================
# Flask Backend Environment Variables
# ============================================================================
# Copy this file to .env and update the values as needed for your deployment

# Application Environment
# development: disables some security checks, allows debug mode
# production: enforces stronger security requirements
APP_ENV=development

# Network Configuration
HOST=127.0.0.1
PORT=5000
DEBUG=True

# JWT Authentication
# IMPORTANT: Change this in production! Generate a secure key:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-insecure-change-me-please-set-jwt-secret-key

# Admin User
# Default admin password. MUST be changed in production!
ADMIN_PASSWORD=admin123

# Data Storage Paths
# DATA_DIR: where blockchain files, wallets, ML model, and metadata DB are stored
# METADATA_DB: SQLite database path (relative to DATA_DIR if not absolute)
# ML_MODEL_PATH: where the trained ML detector pickle file is saved/loaded
DATA_DIR=data
METADATA_DB=data/audit_metadata.db
ML_MODEL_PATH=data/ml_model.pkl

# Wallet Encryption
# Used to encrypt wallet private keys at rest
# If not set, uses JWT_SECRET_KEY
# IMPORTANT: Keep this secret and consistent across restarts!
WALLET_ENCRYPTION_KEY=

# CORS Configuration
# Comma-separated list of origins allowed to call the API
# Example: http://localhost:5173,http://localhost:3000,https://yourdomain.com
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173,http://127.0.0.1:5173

# Backup/Snapshot Management
# Number of backups to keep before older ones are deleted
SNAPSHOT_RETENTION_COUNT=20

# ============================================================================
# Production Checklist
# ============================================================================
# Before deploying to production:
# [ ] Change APP_ENV to 'production'
# [ ] Generate a strong JWT_SECRET_KEY (see command above)
# [ ] Set a strong ADMIN_PASSWORD
# [ ] Change HOST to 0.0.0.0 if using behind reverse proxy
# [ ] Set CORS_ORIGINS to your actual frontend domain(s)
# [ ] Set WALLET_ENCRYPTION_KEY to a random secure value
# [ ] Ensure DATA_DIR points to persistent storage
# [ ] Back up your data/wallets/ and data/audit_metadata.db regularly

